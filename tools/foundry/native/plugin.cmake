# Managed by Foundry. Native adapter source is consumer-owned.
cmake_minimum_required(VERSION 3.25)
project(foundry_plugin VERSION @VERSION@ LANGUAGES C CXX)
set(RAVET "@FRAMEWORK@")
set(FOUNDRY_INSTRUMENT @INSTRUMENT@)
set(FOUNDRY_EDITOR @EDITOR@)
set(FOUNDRY_INCLUDES "${RAVET}/crates/ravet-native/include" "${RAVET}/examples/gain-native/include" "${RAVET}/examples/performance-native/include" "${RAVET}/crates/ravet-webview/include" "${CMAKE_CURRENT_SOURCE_DIR}/../.foundry")
set(FOUNDRY_SYSTEM_LIBS)
if(APPLE)
    enable_language(OBJCXX)
    list(APPEND FOUNDRY_SYSTEM_LIBS "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration" "-framework Cocoa" "-framework WebKit" iconv)
elseif(UNIX)
    list(APPEND FOUNDRY_SYSTEM_LIBS pthread dl m)
elseif(WIN32)
    list(APPEND FOUNDRY_SYSTEM_LIBS ws2_32 userenv bcrypt ntdll)
endif()
if(FOUNDRY_FORMAT STREQUAL "lv2")
    add_library(foundry_plugin_lv2 MODULE lv2.cpp)
    target_compile_features(foundry_plugin_lv2 PRIVATE cxx_std_17)
    target_include_directories(foundry_plugin_lv2 PRIVATE ${FOUNDRY_INCLUDES} "${FOUNDRY_LV2_SDK}/include")
    target_link_libraries(foundry_plugin_lv2 PRIVATE "${FOUNDRY_LIBRARY}" ${FOUNDRY_SYSTEM_LIBS})
    set_target_properties(foundry_plugin_lv2 PROPERTIES PREFIX "" SUFFIX ".so")
elseif(FOUNDRY_FORMAT STREQUAL "auv3")
    if(NOT APPLE OR FOUNDRY_INSTRUMENT)
        message(FATAL_ERROR "AUv3 starter requires macOS and the effect template")
    endif()
    add_library(foundry_auv3 STATIC "${RAVET}/native/apple/RavetAudioUnit.mm" "${RAVET}/native/apple/RavetParameterViewController.mm" auv3/GainAudioUnit.mm)
    target_compile_features(foundry_auv3 PUBLIC cxx_std_17)
    target_include_directories(foundry_auv3 PUBLIC auv3 "${RAVET}/native/apple" "${RAVET}/native/common" ${FOUNDRY_INCLUDES})
    target_compile_options(foundry_auv3 PRIVATE -fobjc-arc -fapplication-extension)
    target_link_libraries(foundry_auv3 PUBLIC "${FOUNDRY_LIBRARY}" ${FOUNDRY_SYSTEM_LIBS} "-framework AudioToolbox" "-framework AVFoundation" "-framework CoreMIDI" "-framework CoreAudioKit" "-framework Foundation")
    add_executable(RavetGainExtension MACOSX_BUNDLE auv3/Extension.mm)
    set_target_properties(RavetGainExtension PROPERTIES BUNDLE_EXTENSION appex MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/../.foundry/AUv3.plist")
    target_compile_options(RavetGainExtension PRIVATE -fobjc-arc -fapplication-extension)
    target_link_libraries(RavetGainExtension PRIVATE foundry_auv3)
    target_link_options(RavetGainExtension PRIVATE "-Wl,-e,_NSExtensionMain")
    add_executable(RavetGainContainer MACOSX_BUNDLE auv3/Container.cpp)
    set_target_properties(RavetGainContainer PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/../.foundry/Container.plist")
    add_custom_target(foundry_plugin_auv3 DEPENDS RavetGainContainer RavetGainExtension
        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_BUNDLE_DIR:RavetGainContainer>/Contents/PlugIns"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "$<TARGET_BUNDLE_DIR:RavetGainExtension>" "$<TARGET_BUNDLE_DIR:RavetGainContainer>/Contents/PlugIns/RavetGainExtension.appex")
else()
    set(SMTG_ENABLE_VST3_PLUGIN_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(SMTG_ENABLE_VST3_HOSTING_EXAMPLES ON CACHE BOOL "" FORCE)
    set(SMTG_ENABLE_VSTGUI_SUPPORT OFF CACHE BOOL "" FORCE)
    set(SMTG_CREATE_PLUGIN_LINK OFF CACHE BOOL "" FORCE)
    set(SMTG_RUN_VST_VALIDATOR OFF CACHE BOOL "" FORCE)
    set(SMTG_ENABLE_AUV2_BUILDS OFF CACHE BOOL "" FORCE)
    set(SMTG_ENABLE_AAX_BUILDS OFF CACHE BOOL "" FORCE)
    if(FOUNDRY_FORMAT STREQUAL "aax")
        set(SMTG_AAX_SDK_PATH "${FOUNDRY_AAX_SDK}" CACHE PATH "" FORCE)
    endif()
    add_subdirectory("${FOUNDRY_VST3_SDK}" sdk-build)
    set(public_sdk_SOURCE_DIR "${FOUNDRY_VST3_SDK}/public.sdk")
    smtg_add_vst3plugin(foundry_plugin_vst3 plugin.cpp)
    if(FOUNDRY_FORMAT STREQUAL "aax")
        if(NOT TARGET aax_wrapper)
            message(FATAL_ERROR "External SDK did not provide aax_wrapper")
        endif()
        list(APPEND CMAKE_MODULE_PATH "${FOUNDRY_VST3_SDK}/cmake/modules")
        include(SMTG_AddAAXLibrary)
        smtg_add_aaxplugin(foundry_plugin_aax plugin.cpp aax.cpp)
        target_link_libraries(foundry_plugin_aax PRIVATE aax_wrapper)
        set(native_targets foundry_plugin_vst3 foundry_plugin_aax)
    else()
        set(native_targets foundry_plugin_vst3)
    endif()
    foreach(target IN LISTS native_targets)
        smtg_target_add_library_main(${target})
        target_sources(${target} PRIVATE "${FOUNDRY_VST3_SDK}/public.sdk/source/vst/vstaudioeffect.cpp" "${FOUNDRY_VST3_SDK}/public.sdk/source/vst/vsteditcontroller.cpp")
        target_compile_features(${target} PRIVATE cxx_std_17)
        target_include_directories(${target} PRIVATE "${FOUNDRY_VST3_SDK}" ${FOUNDRY_INCLUDES})
        target_link_libraries(${target} PRIVATE sdk "${FOUNDRY_LIBRARY}" ${FOUNDRY_SYSTEM_LIBS})
        if(APPLE)
            smtg_target_set_bundle(${target} BUNDLE_IDENTIFIER "@PLUGIN_ID@.${FOUNDRY_FORMAT}" COMPANY_NAME "@COMPANY@")
            if(FOUNDRY_EDITOR)
                target_compile_definitions(${target} PRIVATE RAVET_NATIVE_WEB_EDITOR=1)
            endif()
        endif()
    endforeach()
    if(FOUNDRY_FORMAT STREQUAL "au")
        set(au_source "${FOUNDRY_VST3_SDK}/public.sdk/source/vst/auwrapper/auwrapper.mm")
        set(au_only 1)
        if(FOUNDRY_INSTRUMENT)
            set(au_source au.mm)
            set(au_only 0)
        endif()
        add_library(foundry_plugin_au MODULE ${au_source} "${FOUNDRY_VST3_SDK}/public.sdk/source/vst/auwrapper/aucocoaview.mm" "${FOUNDRY_VST3_SDK}/public.sdk/source/vst/auwrapper/NSDataIBStream.mm")
        target_compile_features(foundry_plugin_au PRIVATE cxx_std_23)
        target_compile_definitions(foundry_plugin_au PRIVATE SMTG_AUWRAPPER_USES_AUSDK CA_USE_AUDIO_PLUGIN_ONLY=${au_only} SMTG_AUCocoaUIBase_CLASS_NAME=FoundryAUCocoaView)
        target_include_directories(foundry_plugin_au PRIVATE "${FOUNDRY_VST3_SDK}" "${FOUNDRY_AUDIOUNIT_SDK}/include" ${FOUNDRY_INCLUDES})
        target_link_libraries(foundry_plugin_au PRIVATE sdk_hosting "${FOUNDRY_AUDIOUNIT_LIBRARY}" "${FOUNDRY_LIBRARY}" ${FOUNDRY_SYSTEM_LIBS} "-framework AudioUnit" "-framework CoreMIDI" "-framework AudioToolbox" "-framework Carbon" "-framework CoreAudio")
        set_target_properties(foundry_plugin_au PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION component MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/../.foundry/AU.plist" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/AU")
        add_dependencies(foundry_plugin_au foundry_plugin_vst3)
    endif()
endif()
