# Opt-in archive consumers qualify exact canonical table identities across Rust
# codegen units, then prepare/process/snapshot real paired32/64 default consumers.
if(DEFINED RAVET_PERFORMANCE_LIBRARY AND DEFINED RAVET_BUS_LIBRARY)
    foreach(mode IN ITEMS normal fast)
        set(target ravet_native_table_identity_${mode})
        add_executable(${target} table_identity.cpp)
        target_compile_features(${target} PRIVATE cxx_std_17)
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        target_include_directories(${target} PRIVATE ../../crates/ravet-native/include ../../examples/performance-native/include ../../examples/bus-routing-native/include)
        target_link_libraries(${target} PRIVATE "${RAVET_GAIN_LIBRARY}" "${RAVET_PERFORMANCE_LIBRARY}" "${RAVET_BUS_LIBRARY}")
        if(APPLE)
            target_link_libraries(${target} PRIVATE "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration" iconv)
            if(RAVET_VALIDATE_WEB_EDITOR)
                target_link_libraries(${target} PRIVATE "-framework Cocoa" "-framework WebKit")
            endif()
        endif()
        if(mode STREQUAL fast AND CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
            target_compile_options(${target} PRIVATE -ffast-math)
        endif()
        add_test(NAME ${target} COMMAND ${target})
    endforeach()
endif()
