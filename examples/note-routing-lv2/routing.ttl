@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix resize: <http://lv2plug.in/ns/ext/resize-port#> .

<urn:ravet:note-routing:mono> a lv2:Plugin, lv2:UtilityPlugin ;
  doap:name "RAVET Note Routing mono" ; doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:requiredFeature urid:map ; lv2:extensionData state:interface ;
  lv2:port [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "out1" ; lv2:name "Silent output 1" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "level" ; lv2:name "On velocity Level" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 1.0 ],
    [ a lv2:InputPort, atom:AtomPort ; lv2:index 2 ; lv2:symbol "notes" ; lv2:name "Notes and transport" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent, time:Position ],
    [ a lv2:OutputPort, atom:AtomPort ; lv2:index 3 ; lv2:symbol "routed" ; lv2:name "Routed notes" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ; resize:minimumSize 24592 ] .

<urn:ravet:note-routing:stereo> a lv2:Plugin, lv2:UtilityPlugin ;
  doap:name "RAVET Note Routing stereo" ; doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:requiredFeature urid:map ; lv2:extensionData state:interface ;
  lv2:port [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "out1" ; lv2:name "Silent output 1" ],
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out2" ; lv2:name "Silent output 2" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "level" ; lv2:name "On velocity Level" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 1.0 ],
    [ a lv2:InputPort, atom:AtomPort ; lv2:index 3 ; lv2:symbol "notes" ; lv2:name "Notes and transport" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent, time:Position ],
    [ a lv2:OutputPort, atom:AtomPort ; lv2:index 4 ; lv2:symbol "routed" ; lv2:name "Routed notes" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ; resize:minimumSize 24592 ] .

