@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<urn:ravet:gain:mono> a lv2:Plugin, lv2:AmplifierPlugin ;
  doap:name "RAVET Gain mono" ;
  doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ;
  lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in1" ; lv2:name "Input 1" ],
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out1" ; lv2:name "Output 1" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:minimum 0.0 ; lv2:maximum 4.0 ; lv2:default 1.0 ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.0 ; lv2:portProperty lv2:toggled, lv2:integer ] .

<urn:ravet:gain:stereo> a lv2:Plugin, lv2:AmplifierPlugin ;
  doap:name "RAVET Gain stereo" ;
  doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ;
  lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in1" ; lv2:name "Input 1" ],
    [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in2" ; lv2:name "Input 2" ],
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out1" ; lv2:name "Output 1" ],
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out2" ; lv2:name "Output 2" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:minimum 0.0 ; lv2:maximum 4.0 ; lv2:default 1.0 ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.0 ; lv2:portProperty lv2:toggled, lv2:integer ] .
