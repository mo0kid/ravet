@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<urn:ravet:performance-sine:mono> a lv2:Plugin, lv2:InstrumentPlugin ;
  doap:name "RAVET Performance Sine mono" ; doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:requiredFeature urid:map ; lv2:extensionData state:interface ;
  lv2:port [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "out1" ; lv2:name "Output 1" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.2 ],
    [ a lv2:InputPort, atom:AtomPort ; lv2:index 2 ; lv2:symbol "notes" ; lv2:name "Notes and transport" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent, time:Position ] .

<urn:ravet:performance-sine:stereo> a lv2:Plugin, lv2:InstrumentPlugin ;
  doap:name "RAVET Performance Sine stereo" ; doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
  lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:requiredFeature urid:map ; lv2:extensionData state:interface ;
  lv2:port [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "out1" ; lv2:name "Output 1" ],
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out2" ; lv2:name "Output 2" ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.2 ],
    [ a lv2:InputPort, atom:AtomPort ; lv2:index 3 ; lv2:symbol "notes" ; lv2:name "Notes and transport" ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent, time:Position ] .
