# Authored native processor/model; proprietary SDK implementation stays external.
if(NOT EXISTS "${RAVET_BUS_ROUTING_LIBRARY}")
    message(FATAL_ERROR "Set RAVET_BUS_ROUTING_LIBRARY to the public ravet-bus-routing-native archive for mandatory multibus contracts")
endif()
target_include_directories(ravet_gain_aax PRIVATE
    "${RAVET_AAX_SDK}/Interfaces" "${RAVET_AAX_SDK}/Interfaces/ACF"
    "${CMAKE_CURRENT_SOURCE_DIR}/../gain-aax")
set(ravet_aax_owner_targets ravet_aax_native_parameters ravet_aax_native_parameters_fast ravet_aax_processor ravet_aax_processor_fast ravet_aax_model ravet_aax_model_fast ravet_aax_transport ravet_aax_transport_fast ravet_aax_transport_model ravet_aax_transport_model_fast ravet_aax_audio ravet_aax_audio_fast ravet_aax_multibus ravet_aax_multibus_fast ravet_aax_midi_output ravet_aax_midi_output_fast ravet_aax_generated_model ravet_aax_generated_model_fast ravet_aax_timing_model ravet_aax_timing_model_fast)
if(APPLE)
    list(APPEND ravet_aax_owner_targets ravet_aax_native_registered_contracts)
endif()
foreach(aax_target IN LISTS ravet_aax_owner_targets)
    if(aax_target STREQUAL "ravet_aax_native_registered_contracts")
        set(aax_source registered-native.cpp)
    elseif(aax_target MATCHES "timing_model")
        set(aax_source timing-model.cpp)
    elseif(aax_target MATCHES "generated_model")
        set(aax_source generated-model.cpp)
    elseif(aax_target MATCHES "midi_output")
        set(aax_source midi-output.cpp)
    elseif(aax_target MATCHES "multibus")
        set(aax_source multibus.cpp)
    elseif(aax_target MATCHES "audio")
        set(aax_source bus-audio.cpp)
    elseif(aax_target MATCHES "transport_model")
        set(aax_source transport-model.cpp)
    elseif(aax_target MATCHES "transport")
        set(aax_source transport.cpp)
    elseif(aax_target MATCHES "native_parameters")
        set(aax_source parameters.cpp)
    elseif(aax_target MATCHES "model")
        set(aax_source model.cpp)
    else()
        set(aax_source processor.cpp)
    endif()
    add_executable(${aax_target} "${CMAKE_CURRENT_SOURCE_DIR}/../../tools/aax-validation/${aax_source}"
        "${CMAKE_CURRENT_SOURCE_DIR}/../../tools/aax-validation/description-stub.cpp")
    target_compile_features(${aax_target} PRIVATE cxx_std_17)
    if(aax_target STREQUAL "ravet_aax_native_registered_contracts")
        target_compile_definitions(${aax_target} PRIVATE RAVET_AAX_NATIVE_SAMPLE_BITS=${RAVET_AAX_INTERNAL_PRECISION})
    endif()
    target_include_directories(${aax_target} PRIVATE
        "${RAVET_VST3_SDK}" "${RAVET_AAX_SDK}/Interfaces" "${RAVET_AAX_SDK}/Interfaces/ACF"
        "${CMAKE_CURRENT_SOURCE_DIR}/../gain-aax" "${CMAKE_CURRENT_SOURCE_DIR}/../gain-native/include"
        "${CMAKE_CURRENT_SOURCE_DIR}/../bus-routing-native/include"
        "${CMAKE_CURRENT_SOURCE_DIR}/../../crates/ravet-native/include")
    if(aax_target MATCHES "multibus|generated_model|timing_model")
        target_link_libraries(${aax_target} PRIVATE aax_wrapper sdk "${RAVET_BUS_ROUTING_LIBRARY}")
    else()
        target_link_libraries(${aax_target} PRIVATE aax_wrapper sdk "${RAVET_GAIN_LIBRARY}")
    endif()
    if(APPLE)
        target_link_libraries(${aax_target} PRIVATE "-framework Security" "-framework CoreFoundation"
            "-framework SystemConfiguration" "-framework Carbon" "-framework Cocoa" iconv)
    endif()
    if(aax_target MATCHES "_fast$")
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
            target_compile_options(${aax_target} PRIVATE -ffast-math)
        elseif(MSVC)
            target_compile_options(${aax_target} PRIVATE /fp:fast)
        endif()
    endif()
    if(NOT aax_target STREQUAL "ravet_aax_native_registered_contracts")
        add_test(NAME ${aax_target} COMMAND ${aax_target})
    endif()
endforeach()
