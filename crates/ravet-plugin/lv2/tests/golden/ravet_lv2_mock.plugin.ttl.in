@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .

<urn:org.ravet.mock>
  a lv2:Plugin, doap:Project ;
  doap:name "RAVET Mock" ;
  doap:maintainer [ foaf:name "RAVET" ; foaf:homepage <https://example.org/ravet-mock> ] ;
  rdfs:comment "Version 1.2.3" ;
  lv2:minorVersion 1002 ;
  lv2:microVersion 3 ;
  lv2:optionalFeature urid:map, opts:options, bufsz:boundedBlockLength ;
  opts:supportedOption bufsz:maxBlockLength, bufsz:nominalBlockLength ;
  lv2:extensionData state:interface ;
  ui:ui <urn:org.ravet.mock#ui> ;
  lv2:port [
    a lv2:InputPort, lv2:AudioPort ;
    lv2:index 0 ;
    lv2:symbol "in_1" ;
    lv2:name "Left In"
  ] , [
    a lv2:InputPort, lv2:AudioPort ;
    lv2:index 1 ;
    lv2:symbol "in_2" ;
    lv2:name "Right In"
  ] , [
    a lv2:OutputPort, lv2:AudioPort ;
    lv2:index 2 ;
    lv2:symbol "out_1" ;
    lv2:name "Left Out"
  ] , [
    a lv2:OutputPort, lv2:AudioPort ;
    lv2:index 3 ;
    lv2:symbol "out_2" ;
    lv2:name "Right Out"
  ] , [
    a lv2:InputPort, atom:AtomPort ;
    lv2:index 4 ;
    lv2:symbol "events_in" ;
    lv2:name "Events In" ;
    atom:bufferType atom:Sequence ;
    atom:supports time:Position, midi:MidiEvent ;
    lv2:designation lv2:control ;
    lv2:portProperty lv2:connectionOptional
  ] , [
    a lv2:OutputPort, atom:AtomPort ;
    lv2:index 5 ;
    lv2:symbol "midi_out" ;
    lv2:name "MIDI Out" ;
    atom:bufferType atom:Sequence ;
    atom:supports midi:MidiEvent ;
    lv2:portProperty lv2:connectionOptional
  ] , [
    a lv2:OutputPort, lv2:ControlPort ;
    lv2:index 6 ;
    lv2:symbol "latency" ;
    lv2:name "Latency" ;
    lv2:designation lv2:latency ;
    lv2:minimum 0 ;
    lv2:maximum 192000 ;
    lv2:portProperty lv2:integer, pprops:notOnGUI ;
    units:unit units:frame
  ] , [
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 7 ;
    lv2:symbol "gain" ;
    lv2:name "Gain" ;
    lv2:default 0.0 ;
    lv2:minimum -60.0 ;
    lv2:maximum 12.0 ;
    units:unit units:db
  ] , [
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 8 ;
    lv2:symbol "enabled" ;
    lv2:name "Enabled" ;
    lv2:designation lv2:enabled ;
    lv2:default 1 ;
    lv2:minimum 0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled, lv2:integer
  ] , [
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 9 ;
    lv2:symbol "mode" ;
    lv2:name "Mode" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 3.0 ;
    lv2:portProperty lv2:integer, lv2:enumeration ;
    lv2:scalePoint [ rdfs:label "Clean" ; rdf:value 0.0 ], [ rdfs:label "Warm" ; rdf:value 1.0 ], [ rdfs:label "Hot" ; rdf:value 2.0 ], [ rdfs:label "Fuzz" ; rdf:value 3.0 ]
  ] , [
    a lv2:OutputPort, lv2:ControlPort ;
    lv2:index 10 ;
    lv2:symbol "level" ;
    lv2:name "Level" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0
  ] .

<urn:org.ravet.mock#ui>
  a ui:@RAVET_LV2_UI_CLASS@ ;
  lv2:requiredFeature ui:idleInterface, ui:parent ;
  lv2:optionalFeature ui:resize, ui:touch ;
  lv2:extensionData ui:idleInterface, ui:resize ;
  ui:portNotification [ ui:plugin <urn:org.ravet.mock> ; lv2:symbol "gain" ; ui:protocol ui:floatProtocol ] ;
  ui:portNotification [ ui:plugin <urn:org.ravet.mock> ; lv2:symbol "enabled" ; ui:protocol ui:floatProtocol ] ;
  ui:portNotification [ ui:plugin <urn:org.ravet.mock> ; lv2:symbol "mode" ; ui:protocol ui:floatProtocol ] ;
  ui:portNotification [ ui:plugin <urn:org.ravet.mock> ; lv2:symbol "level" ; ui:protocol ui:floatProtocol ] .
